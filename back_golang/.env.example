PORT=8080

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=divieat

# --- Auth & CORS ---
JWT_SECRET=change-me-in-production
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Pey / CoDi ---
# Key from the portal: https://portal.mipey.mx/developers
# Sent as `Authorization: Bearer <key>`.
PEY_API_KEY=
PEY_BASE_URL=https://api.pey.mx

# Webhook secret, generated when you create the webhook in the portal.
# Signatures follow the Standard Webhooks spec (whsec_...).
PEY_WEBHOOK_SECRET=

# ULID of the bank account that receives the payment. Optional: without it,
# Pey uses whichever account is tied to the key.
PEY_BANK_ACCOUNT_ID=

# CoDi QR lifetime in seconds. 0 means no expiry; once set, the minimum Pey
# accepts is 360.
PEY_QR_EXPIRATION_SECONDS=900

# Pey has NO sandbox: you test in production with tiny amounts ($0.01 MXN).
# While this is true, the backend refuses charges above the ceiling.
PEY_TEST_MODE=true
PEY_TEST_MAX_AMOUNT_MXN=1
