# --- Base de datos ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=divieat

# --- Pey · CoDi ---
# Llave del portal: https://portal.mipey.mx/developers
# Se pasa como `Authorization: Bearer <llave>`.
PEY_API_KEY=
PEY_BASE_URL=https://api.pey.mx

# Secreto del webhook, se genera al crear el webhook en el portal.
# Las firmas siguen el estandar Standard Webhooks (whsec_...).
PEY_WEBHOOK_SECRET=

# Cuenta (ULID) que recibe el pago. Opcional: si se omite, Pey usa la que
# este ligada a la llave.
PEY_BANK_ACCOUNT_ID=

# Vigencia del QR CoDi en segundos. 0 = sin expiracion; si se define, el
# minimo que acepta Pey es 360.
PEY_QR_EXPIRATION_SECONDS=900

# Pey NO tiene sandbox todavia: se prueba en produccion con montos minimos
# ($0.01 MXN). Pon esto en true para que el backend se niegue a crear cobros
# por encima de PEY_LIMITE_PRUEBA_MXN.
PEY_TEST_MODE=true
PEY_TEST_MAX_AMOUNT_MXN=1
